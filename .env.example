# Discord bot
# DISCORD_TOKEN: Bot tab -> "Reset Token" / "Copy"
DISCORD_TOKEN=
# DISCORD_CLIENT_ID: aka "Application ID". General Information tab -> "Application ID"
DISCORD_CLIENT_ID=
# Optional: restrict slash command registration to a single guild for fast iteration
# (right-click your test server icon in Discord -> "Copy Server ID")
DISCORD_DEV_GUILD_ID=
# Optional: set to true to (re)register slash commands automatically on startup,
# so a redeploy keeps Discord in sync without running `npm run register` (default: off)
# REGISTER_ON_BOOT=true

# Supabase (used by the bot at runtime)
# Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres direct connection (only used by `npm run db:migrate`).
# Project Settings -> Database -> Connection string.
# Example: postgresql://postgres.<ref>:<password>@aws-1-us-east-2.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Optional
# LOG_FORMAT=json         # structured JSON logs for production aggregators
# DEBUG=1                 # verbose debug logs
# HOROSCOPE_ENABLED=false # disable the daily horoscope follow-up (default: enabled)
# HOROSCOPE_THREAD=false  # post horoscope inline instead of in a thread (default: thread)

# Calendar feed (optional) — live subscribe-by-URL .ics feed for Google/Apple/Outlook.
# The downloadable export command (/birthday-export-calendar) works without any of these.
# CALENDAR_FEED_ENABLED=false   # set to false to skip starting the HTTP feed server (default: enabled)
# CALENDAR_PUBLIC_URL=          # public base URL of this bot (e.g. https://your-bot.up.railway.app);
#                               # required for /birthday-calendar-feed to print a full subscribe link
# PORT=8080                     # port the feed server listens on (most hosts inject this automatically)
